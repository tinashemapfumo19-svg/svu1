SVU_APP_NAME="South Valley University"
SVU_ENV=development
SVU_HOST=127.0.0.1
SVU_PORT=4173
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/svu_rebuild

# Required outside development: base64-encoded 32-byte key for secrets at rest and signed document links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SVU_DATA_KEY=

# MFA policy: off | enrolled (development default) | privileged (default elsewhere).
# SVU_MFA_POLICY=enrolled

# Development-only folders (ignored outside development).
# SVU_DEV_OUTBOX=data/dev-outbox
# SVU_DEV_STORAGE=data/dev-storage
